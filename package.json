{
  "name": "react-electron-pos",
  "version": "1.0.1",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run react\" \"npm run electron\"",
    "react": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "test:variants": "electron scripts/verify-product-variants.js",
    "test:discounts": "electron scripts/verify-sale-discounts.js",
    "test:sale-updates": "electron scripts/verify-sale-updates.js",
    "test:services": "electron scripts/verify-service-products.js",
    "test:warehouses": "electron scripts/verify-warehouses.js",
    "test:units": "electron scripts/verify-unit-conversions.js",
    "test:database": "electron scripts/verify-database-singleton.js",
    "test:printer-settings": "electron scripts/verify-printer-settings.js",
    "test:product-archive": "electron scripts/verify-product-archive.js",
    "test:customer-statement": "electron scripts/verify-customer-statement.js",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "12.10.0",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.2",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "electron": "41.10.1",
    "electron-builder": "26.8.2",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "POS System",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "omar25956-rgb",
        "repo": "pos-system"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/pos.db",
        "to": "pos.db"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
